@page "/KiUpdate"
@using System.Collections.ObjectModel
@using System.Text.Json
@using System.Text.RegularExpressions
@using Blazored.LocalStorage
@using NshmCalculator.MudClient.Components.Dialog
@using NshmCalculator.MudClient.Utilities
@using NshmCalculator.Shared.Models.CalculatorModel.CalculatorConfig
@using NshmCalculator.Shared.Models.CalculatorModel.FormulaParam.Params
@using NshmCalculator.Shared.Models.PageModel
@using Align = MudBlazor.Align
@using Color = MudBlazor.Color
@inject ISyncLocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject HttpClient Client

<PageTitle>升级内功词条计算器</PageTitle>

<MudGrid>
    @if (!renderNotComplete)
    {
        <MudItem xs="12">
            <MudPaper Class="d-flex align-center justify-center py-8">
                <MudStack AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h4">升级内功词条计算器</MudText>
                    <MudText Typo="Typo.h6" Align="Align.Center">
                        <MudChip Icon="@Icons.Material.Filled.Person" Color="Color.Tertiary">B站：-风何往-群热心群友</MudChip>
                        <MudChip Color="Color.Info">源文件版本:@_currentConfig.Version</MudChip>
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h6" Class="mb-4">输入区：填写词条数值，上限/下限/收益率可按需修改</MudText>
                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Centered="true">
                    <MudTabPanel Text="填写数值/上限收益率">
                        <MudTable Items="@_kiUpdatePageModel.AttributeArray" Breakpoint="Breakpoint.None" Striped="true"
                                  Dense="@_denseMode" Elevation="2">
                            <HeaderContent>
                                <MudTh>属性</MudTh>
                                <MudTh>填写数值</MudTh>
                                <MudTh>上限收益率</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="属性">@context.Name</MudTd>
                                <MudTd DataLabel="填写数值">
                                    <MudTextField ShrinkLabel @bind-Value="@context.InputValue" Variant="Variant.Outlined"
                                                  Adornment="@(context.Name == "首领克制" || context.IsDirectAdd ? Adornment.End : Adornment.None)"
                                                  AdornmentText="@(context.Name == "首领克制" || context.IsDirectAdd ? "%" : "")"
                                                  Margin="@(_denseMode ? Margin.Dense : Margin.Normal)" Class="mt-0"/>
                                </MudTd>
                                <MudTd DataLabel="上限收益率">
                                    @if (context.IsDirectAdd)
                                    {
                                        <MudText Align="Align.Center" Color="Color.Default">—</MudText>
                                    }
                                    else
                                    {
                                        <MudTextField ShrinkLabel @bind-Value="@context.MaxRate" Variant="Variant.Outlined"
                                                      Adornment="Adornment.End" AdornmentText="%"
                                                      Margin="@(_denseMode ? Margin.Dense : Margin.Normal)" Class="mt-0"/>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudTabPanel>
                    <MudTabPanel Text="数值上限/下限">
                        <MudTable Items="@_kiUpdatePageModel.AttributeArray" Breakpoint="Breakpoint.None" Striped="true"
                                  Dense="@_denseMode" Elevation="2">
                            <HeaderContent>
                                <MudTh>属性</MudTh>
                                <MudTh>数值上限</MudTh>
                                <MudTh>数值下限</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="属性">@context.Name</MudTd>
                                <MudTd DataLabel="数值上限">
                                    @if (context.IsDirectAdd)
                                    {
                                        <MudText Align="Align.Center" Color="Color.Default">—</MudText>
                                    }
                                    else
                                    {
                                        <MudTextField ShrinkLabel @bind-Value="@context.MaxValue" Variant="Variant.Outlined"
                                                      Adornment="@(context.Name == "首领克制" ? Adornment.End : Adornment.None)"
                                                      AdornmentText="@(context.Name == "首领克制" ? "%" : "")"
                                                      Margin="@(_denseMode ? Margin.Dense : Margin.Normal)" Class="mt-0"/>
                                    }
                                </MudTd>
                                <MudTd DataLabel="数值下限">
                                    @if (context.IsDirectAdd)
                                    {
                                        <MudText Align="Align.Center" Color="Color.Default">—</MudText>
                                    }
                                    else
                                    {
                                        <MudTextField ShrinkLabel @bind-Value="@context.MinValue" Variant="Variant.Outlined"
                                                      Adornment="@(context.Name == "首领克制" ? Adornment.End : Adornment.None)"
                                                      AdornmentText="@(context.Name == "首领克制" ? "%" : "")"
                                                      Margin="@(_denseMode ? Margin.Dense : Margin.Normal)" Class="mt-0"/>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h6" Class="mb-4">OCR 识别区：粘贴识别文本或图片识别，自动填入对应列</MudText>
                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Centered="true" @bind-ActivePanelIndex="_activeOcrTab">
                    <MudTabPanel Text="填写数值识别">
                        <MudTextField ShrinkLabel T="string" @bind-Value="_ocrFillText" Label="粘贴识别文本"
                                      Variant="Variant.Outlined" Margin="Margin.Normal" Lines="3"/>
                        <MudStack Row="true" Spacing="2" Class="mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Info"
                                       ButtonType="ButtonType.Button" OnClick="OpenOcrImageDialog"
                                       StartIcon="@Icons.Material.Filled.Image">
                                图片自动识别
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                       ButtonType="ButtonType.Button" OnClick="OnRecognizeFill">
                                手动识别
                            </MudButton>
                        </MudStack>
                    </MudTabPanel>
                    <MudTabPanel Text="上限收益率识别">
                        <MudTextField ShrinkLabel T="string" @bind-Value="_ocrRateText" Label="粘贴识别文本"
                                      Variant="Variant.Outlined" Margin="Margin.Normal" Lines="3"/>
                        <MudStack Row="true" Spacing="2" Class="mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Info"
                                       ButtonType="ButtonType.Button" OnClick="OpenOcrImageDialog"
                                       StartIcon="@Icons.Material.Filled.Image">
                                图片自动识别
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                       ButtonType="ButtonType.Button" OnClick="OnRecognizeRate">
                                手动识别
                            </MudButton>
                        </MudStack>
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h6" Class="mb-4">输出区</MudText>
                <MudTabs KeepPanelsAlive="true" Elevation="2" PanelClass="pa-2" ApplyEffectsToContainer="true">
                    <MudTabPanel Text="输出结果">
                        @if (_results.Count > 0)
                        {
                            <MudTable Items="@_sortedResults" Breakpoint="Breakpoint.None" Striped="true"
                                      Dense="@_denseMode" Elevation="2">
                                <HeaderContent>
                                    <MudTh>属性</MudTh>
                                    <MudTh>属性值</MudTh>
                                    <MudTh>
                                        <MudTableSortLabel InitialDirection="SortDirection.Descending"
                                                           SortBy="new Func<KiUpdateResult, object>(x => x.ActualRate)">
                                            实际收益率
                                        </MudTableSortLabel>
                                    </MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="属性">@context.Name</MudTd>
                                    <MudTd DataLabel="属性值">@FormatInputValue(context)</MudTd>
                                    <MudTd DataLabel="实际收益率">@context.ActualRate.ToString("P2")</MudTd>
                                </RowTemplate>
                            </MudTable>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4">
                                <MudChip T="string" Color="Color.Success">总实际收益率</MudChip>
                                <MudText Typo="Typo.h6" Color="Color.Success" Class="ml-2">@_totalRate.ToString("P2")</MudText>
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default" Class="py-4">
                                暂无结果，请先填写词条数值并点击「计算」
                            </MudText>
                        }
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="mt-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(_results.Count == 0)"
                                       OnClick="OnSaveRecord">保存内功记录
                            </MudButton>
                        </MudStack>
                    </MudTabPanel>

                    <MudTabPanel Text="保存内功记录">
                        @if (_recordObservable.Count > 0)
                        {
                            <MudTable T="KiUpdateRecord" Items="@_recordObservable" Breakpoint="Breakpoint.None" Striped="true"
                                      Dense="@_denseMode" Elevation="2" OnRowClick="OnRecordClick">
                                <HeaderContent>
                                    <MudTh>内功名称</MudTh>
                                    <MudTh>
                                        <MudTableSortLabel InitialDirection="SortDirection.Descending"
                                                           SortBy="new Func<KiUpdateRecord, object>(x => x.TotalRate)">
                                            计算收益
                                        </MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>备注</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="内功名称">@context.Title</MudTd>
                                    <MudTd DataLabel="计算收益">@context.TotalRate.ToString("P2")</MudTd>
                                    <MudTd DataLabel="备注">@context.Remark</MudTd>
                                </RowTemplate>
                                <PagerContent>
                                    <MudTablePager PageSizeOptions="new[] { 10 }" HideRowsPerPage="true"/>
                                </PagerContent>
                            </MudTable>
                        }
                        else
                        {
                            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default" Class="py-4">
                                暂无保存的内功记录，计算后可在「输出结果」页点击保存
                            </MudText>
                        }
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </MudItem>
    }
    else
    {
        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <MudSkeleton/>
                <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Height="300px"/>
                <MudSkeleton/>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <MudSkeleton/>
                <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Height="300px"/>
                <MudSkeleton/>
            </MudPaper>
        </MudItem>
    }

    <MudItem xs="12" Class="d-flex align-center justify-center">
        <MudStack Row="true" Spacing="4">
            <MudButton Variant="Variant.Filled" Disabled="@renderNotComplete" Color="Color.Info" Class="d-flex"
                       ButtonType="ButtonType.Button" OnClick="OnCalculate">计算
            </MudButton>
            <MudButton Variant="Variant.Filled" Disabled="@renderNotComplete" Color="Color.Default" Class="d-flex"
                       ButtonType="ButtonType.Button" OnClick="ShowTips">帮助说明
            </MudButton>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private readonly DialogParameters<TipsDialog> _tipsDialogParameters = new();
    private readonly DialogOptions _tipsDialogOptions = new();

    private KiUpdateConfig _currentConfig;
    private KiUpdatePageModel _kiUpdatePageModel;
    private List<KiUpdateResult> _results = new();
    private List<KiUpdateResult> _sortedResults = new();
    private double _totalRate;
    private string _ocrFillText;
    private string _ocrRateText;
    private bool renderNotComplete { get; set; } = true;
    private bool _denseMode;

    // ---- OCR 图片识别相关状态 ----
    // 当前激活的 OCR 标签页索引：0=填写数值识别，1=上限收益率识别。决定识别文本回写目标。
    private int _activeOcrTab;

    // ---- 保存内功记录相关状态 ----
    // 内功记录页面数据模型（持久化，键名 _kiUpdateRecordPageModel）
    private KiUpdateRecordPageModel _kiUpdateRecordPageModel;
    // 内功记录列表（绑定到 MudTable）
    private ObservableCollection<KiUpdateRecord> _recordObservable = new();
    // 保存对话框参数/选项
    private readonly DialogParameters<KiUpdateSaveDialog> _saveDialogParameters = new();
    private readonly DialogOptions _recordDialogOptions = new() { DisableBackdropClick = true, FullWidth = true, MaxWidth = MaxWidth.Medium };


    protected override async Task OnInitializedAsync()
    {
        renderNotComplete = true;
        _denseMode = LocalStorage.GetItem<bool>(ConstText.DenseModeName);
        await InitParameters();
        await base.OnInitializedAsync();
        LocalStorage.SetItemAsString(ConstText.LastVisitName, "KiUpdate");
    }

    private async Task InitParameters()
    {
        bool haveUpdate = await LoadData();
        _tipsDialogParameters.Add(nameof(TipsDialog.ContentText), new MarkupString(_currentConfig.HelperText));
        _tipsDialogOptions.CloseButton = true;
        if (_currentConfig == null)
        {
            Snackbar.Add(ConstText.ConfigNotFoundText, Severity.Error);
            return;
        }

        if (haveUpdate || _kiUpdatePageModel.AttributeArray is null || _kiUpdatePageModel.AttributeArray.Length == 0)
        {
            // 配置更新或本地缓存无效（被手动清除）：刷新上限/下限/收益率默认值，保留用户已填写的填写数值
            var oldInputDic = _kiUpdatePageModel.AttributeArray?
                .Where(a => a.InputValue.HasValue)
                .ToDictionary(a => a.Name, a => a.InputValue) ?? new Dictionary<string, double?>();
            _kiUpdatePageModel.AttributeArray = _currentConfig.AttributeArray;
            // 旧版本（<20260701002）首领克制的填写数值/上限等是小数形式，需迁移为百分数值
            bool migrateFromDecimal = _kiUpdatePageModel.CurrentInternalVersion < 20260701002;
            foreach (var attr in _kiUpdatePageModel.AttributeArray)
            {
                if (oldInputDic.TryGetValue(attr.Name, out var oldInput))
                {
                    // 首领克制的旧填写数值是小数（如 0.011），迁移为百分数值（1.1）
                    attr.InputValue = migrateFromDecimal && attr.Name == "首领克制" && oldInput.HasValue && oldInput < 1
                        ? oldInput * 100
                        : oldInput;
                }
            }

            _kiUpdatePageModel.CurrentInternalVersion = _currentConfig.InternalVersion;
            SaveInfo();
        }

        // 加载内功记录：读取 localStorage，并按当前配置复算每条记录的实际收益率
        LoadRecords();

        renderNotComplete = false;
    }

    /// <summary>
    /// 从 localStorage 加载内功记录列表，复算每条记录的实际收益率并构建可观察集合。
    /// </summary>
    private void LoadRecords()
    {
        try
        {
            _kiUpdateRecordPageModel = LocalStorage.GetItem<KiUpdateRecordPageModel>(nameof(_kiUpdateRecordPageModel)) ?? new KiUpdateRecordPageModel();
        }
        catch (Exception e)
        {
            Console.WriteLine("内功记录缓存加载异常" + e);
            _kiUpdateRecordPageModel = new KiUpdateRecordPageModel();
        }

        foreach (var record in _kiUpdateRecordPageModel.Records)
        {
            record.TotalRate = CalcRecordTotalRate(record);
        }

        _recordObservable = new ObservableCollection<KiUpdateRecord>(_kiUpdateRecordPageModel.Records);
    }

    /// <summary>
    /// 基于当前配置属性的上限/上限收益率复算记录的实际收益率（与主计算器公式一致）。
    /// 直接累加型属性（如灵韵）：收益 = 数值 / 100；公式型属性：收益 = 数值 / 数值上限 × 上限收益率 / 100。
    /// </summary>
    private double CalcRecordTotalRate(KiUpdateRecord record)
    {
        if (_currentConfig?.AttributeArray is null || _currentConfig.AttributeArray.Length == 0)
        {
            return 0;
        }

        var attrDic = _currentConfig.AttributeArray.ToDictionary(a => a.Name);
        double total = 0;
        foreach (var pair in record.InputValues)
        {
            if (!attrDic.TryGetValue(pair.Key, out var attr))
            {
                continue;
            }

            double v = pair.Value;
            if (attr.IsDirectAdd)
            {
                total += v / 100;
            }
            else
            {
                if (attr.MaxValue == 0)
                {
                    continue;
                }

                total += v / attr.MaxValue * attr.MaxRate / 100;
            }
        }

        return total;
    }

    /// <summary>
    /// 持久化内功记录列表到 localStorage。
    /// </summary>
    private void SaveRecords()
    {
        LocalStorage.SetItem(nameof(_kiUpdateRecordPageModel), _kiUpdateRecordPageModel);
    }

    private async Task<bool> LoadData()
    {
        try
        {
            _kiUpdatePageModel = LocalStorage.GetItem<KiUpdatePageModel>(nameof(_kiUpdatePageModel)) ?? new KiUpdatePageModel();
        }
        catch (Exception e)
        {
            Console.WriteLine("升级内功词条计算器缓存加载异常" + e);
            _kiUpdatePageModel = new KiUpdatePageModel();
        }

        var result = await ConfigHelper.GetConfigJson(Client, "KiUpdate", LocalStorage);
        if (result.Item1 == ConstText.NotExistText)
        {
            Snackbar.Add(result.Item1, Severity.Error);
        }
        else
        {
            try
            {
                _currentConfig = JsonSerializer.Deserialize<KiUpdateConfig>(result.Item1);
                if (result.Item2)
                {
                    Snackbar.Add("配置数据更新，已加载完成", Severity.Success);
                }
            }
            catch (Exception e)
            {
                Console.WriteLine(e);
                Snackbar.Add("解析配置时出现异常，请检查网络");
            }
        }

        return result.Item2;
    }

    private void OnCalculate()
    {
        _results.Clear();
        _totalRate = 0;

        foreach (var attr in _kiUpdatePageModel.AttributeArray)
        {
            if (!attr.InputValue.HasValue)
            {
                continue;
            }

            // 直接累加型属性（如灵韵）：收益直接等于填写数值的百分比；公式型属性按公式计算
            if (attr.IsDirectAdd)
            {
                double directRate = attr.InputValue.Value / 100;
                _results.Add(new KiUpdateResult(attr.Name, attr.InputValue.Value, directRate, true));
                _totalRate += directRate;
            }
            else
            {
                if (attr.MaxValue == 0)
                {
                    continue;
                }

                double rate = attr.InputValue.Value / attr.MaxValue * attr.MaxRate / 100;
                _results.Add(new KiUpdateResult(attr.Name, attr.InputValue.Value, rate, attr.Name == "首领克制"));
                _totalRate += rate;
            }
        }

        if (_results.Count == 0)
        {
            Snackbar.Add("<ul><li>未检测到已填写的词条数值</li><li>请填写数值后再计算</li></ul>", Severity.Warning);
            return;
        }

        // 默认按收益率降序展示
        _sortedResults = _results.OrderByDescending(r => r.ActualRate).ToList();

        Snackbar.Add(ConstText.SuccessText, Severity.Success);
        SaveInfo();
    }

    /// <summary>
    /// 保存当前计算结果为一条内功记录：弹出保存对话框收集标题/备注，
    /// 从当前 _results 构建各属性填写数值，加入记录列表并持久化。
    /// </summary>
    private async Task OnSaveRecord()
    {
        _saveDialogParameters[nameof(KiUpdateSaveDialog.DenseMode)] = _denseMode;
        var dialog = await Dialog.ShowAsync<KiUpdateSaveDialog>("保存内功记录", _saveDialogParameters, _recordDialogOptions);
        var result = await dialog.Result;
        StateHasChanged();
        if (result.Canceled)
        {
            return;
        }

        if (result.Data is not KiUpdateSaveDialog.SaveResult saveResult)
        {
            return;
        }

        // 从当前计算结果构建属性填写数值字典
        var inputValues = new Dictionary<string, double>();
        foreach (var r in _results)
        {
            inputValues[r.Name] = r.InputValue;
        }

        int newId = _kiUpdateRecordPageModel.Records.Count > 0 ? _kiUpdateRecordPageModel.Records.Max(r => r.Id) + 1 : 1;
        var record = new KiUpdateRecord
        {
            Id = newId,
            Title = saveResult.Title,
            Remark = saveResult.Remark,
            CreatedAt = DateTime.Now,
            InputValues = inputValues,
            TotalRate = _totalRate
        };

        _kiUpdateRecordPageModel.Records.Add(record);
        _recordObservable.Add(record);
        SaveRecords();
        Snackbar.Add("内功记录已保存", Severity.Success);
    }

    /// <summary>
    /// 点击内功记录列表条目：弹出编辑对话框，支持编辑词条数值、复算实际收益率、删除记录。
    /// </summary>
    private async Task OnRecordClick(TableRowClickEventArgs<KiUpdateRecord> args)
    {
        var record = args.Item;
        if (record == null)
        {
            return;
        }

        var parameters = new DialogParameters<KiUpdateRecordDialog>
        {
            [nameof(KiUpdateRecordDialog.Record)] = record,
            [nameof(KiUpdateRecordDialog.ConfigAttributes)] = _currentConfig.AttributeArray,
            [nameof(KiUpdateRecordDialog.DenseMode)] = _denseMode
        };
        var dialog = await Dialog.ShowAsync<KiUpdateRecordDialog>("编辑内功记录", parameters, _recordDialogOptions);
        var result = await dialog.Result;
        StateHasChanged();
        if (result.Canceled)
        {
            return;
        }

        // 返回 null 表示删除该记录
        if (result.Data is null)
        {
            _kiUpdateRecordPageModel.Records.Remove(record);
            _recordObservable.Remove(record);
            SaveRecords();
            Snackbar.Add("内功记录已删除", Severity.Success);
            return;
        }

        // 编辑保存：记录的 InputValues/Remark 已在对话框内回写，此处复算并持久化
        record.TotalRate = CalcRecordTotalRate(record);
        SaveRecords();
        Snackbar.Add("内功记录已更新", Severity.Success);
    }

    /// 文本形如：气血上限 +2084 首领克制 +1.1% 力量/气海 +10 ...
    /// 规则：属性名（开头非数字文本）+ 空格 + +整数或百分数
    /// </summary>
    private void OnRecognizeFill()
    {
        if (string.IsNullOrWhiteSpace(_ocrFillText))
        {
            Snackbar.Add("识别文本为空，请先粘贴内容", Severity.Warning);
            return;
        }

        // 粘贴识别前先清空所有填写数值，确保本次填入的是最新识别结果
        foreach (var attr in _kiUpdatePageModel.AttributeArray)
        {
            attr.InputValue = null;
        }

        // 用已知属性名作为锚点构建正则，避免被噪音前缀干扰（如「新 最小攻击」中的「新」）
        // 按名称长度降序拼接，防止「攻击」误匹配到「最大攻击/最小攻击」前缀
        // 负向后顾断言确保属性名前不是中文字符，防止「抗外功会心」中的「会心」被误匹配
        var attrDic = _kiUpdatePageModel.AttributeArray.ToDictionary(a => a.Name, a => a);
        string nameAlt = string.Join("|", attrDic.Keys.OrderByDescending(n => n.Length).Select(Regex.Escape));
        // 匹配：属性名 + +数值（整数或百分数）
        var matches = Regex.Matches(_ocrFillText, $@"(?<![\u4e00-\u9fa5])({nameAlt})\s*\+(\d+(?:\.\d+)?%?)");

        if (matches.Count == 0)
        {
            Snackbar.Add("未识别到任何属性数值，请检查文本格式", Severity.Warning);
            return;
        }

        int matchedCount = 0;
        foreach (Match m in matches)
        {
            string name = m.Groups[1].Value.Trim();
            string valueStr = m.Groups[2].Value.Trim();

            if (!attrDic.TryGetValue(name, out var attr))
            {
                continue;
            }

            // 解析数值：百分数去 % 后直接用百分数值（如 1.1% -> 1.1，与配置量级一致）
            double value = ParseValueToDouble(valueStr);

            // 同一属性多次出现时累加（如两个攻击词条 31+36=67）
            attr.InputValue = (attr.InputValue ?? 0) + value;
            matchedCount++;
        }

        if (matchedCount == 0)
        {
            Snackbar.Add($"未匹配到任何有效属性，识别到 {matches.Count} 项", Severity.Warning);
            return;
        }

        string tip = $"<ul><li>成功匹配并填入填写数值 {matchedCount} 项（同属性已自动累加）</li>";
        tip += "<li>请在「填写数值/上限收益率」标签页确认，并点击「计算」</li></ul>";
        Snackbar.Add(tip, Severity.Info);
        SaveInfo();
    }

    /// <summary>
    /// 解析 OCR 识别文本，将匹配到的属性数值上限与上限收益率分别填入对应字段。
    /// 文本形如：攻击 33 390(1.63%) 力量/气海 10 360(1.5%) 首领克制 1.2% 270(1.13%) ...
    /// 规则：属性名 + 空格 + 第一个值(数字或百分数) + 空格 + 第二个数字 + 左括号(百分比%)
    /// 第一个值填入数值上限，括号内百分比填入上限收益率
    /// </summary>
    private void OnRecognizeRate()
    {
        if (string.IsNullOrWhiteSpace(_ocrRateText))
        {
            Snackbar.Add("识别文本为空，请先粘贴内容", Severity.Warning);
            return;
        }

        // 用已知属性名作为锚点构建正则，避免被表头/噪音文本干扰
        // 按名称长度降序拼接，防止「攻击」误匹配到「最大攻击」前缀
        var attrDic = _kiUpdatePageModel.AttributeArray.ToDictionary(a => a.Name, a => a);
        string nameAlt = string.Join("|", attrDic.Keys.OrderByDescending(n => n.Length).Select(Regex.Escape));
        // 匹配：属性名 + 第一个值(数字或百分数) + 第二个数字 + (百分比%)
        // 负向后顾断言确保属性名前不是中文字符，防止「抗外功会心」中的「会心」被误匹配
        // 括号兼容全角「（」「）」和半角「(」「)」，OCR 常见全角/半角混用
        var matches = Regex.Matches(_ocrRateText, $@"(?<![\u4e00-\u9fa5])({nameAlt})\s+(\d+(?:\.\d+)?%?)\s+\d+[(（](\d+(?:\.\d+)?)%[)）]");

        if (matches.Count == 0)
        {
            Snackbar.Add("未识别到任何属性收益率，请检查文本格式", Severity.Warning);
            return;
        }

        int matchedCount = 0;
        foreach (Match m in matches)
        {
            string name = m.Groups[1].Value.Trim();
            string maxValueStr = m.Groups[2].Value.Trim();
            string rateStr = m.Groups[3].Value.Trim();

            if (!attrDic.TryGetValue(name, out var attr))
            {
                continue;
            }

            // 第一个值填入数值上限（百分数去 % 后取百分数值，如 1.2% -> 1.2，与配置量级一致）
            attr.MaxValue = ParseValueToDouble(maxValueStr);

            // 括号内百分比填入上限收益率（如 1.63 直接取百分数值 1.63）
            if (double.TryParse(rateStr, out double percentValue))
            {
                attr.MaxRate = percentValue;
                matchedCount++;
            }
        }

        if (matchedCount == 0)
        {
            Snackbar.Add("未匹配到任何有效属性收益率，请检查文本格式", Severity.Warning);
            return;
        }

        string tip = $"<ul><li>成功匹配并填入数值上限与上限收益率 {matchedCount} 项</li>";
        tip += "<li>请在「填写数值/上限收益率」标签页确认，并点击「计算」</li></ul>";
        Snackbar.Add(tip, Severity.Info);
        SaveInfo();
    }

    /// <summary>
    /// 将字符串解析为 double，百分数（如 "1.2%"）去掉 % 后取百分数值（1.2），整数直接返回
    /// </summary>
    private static double ParseValueToDouble(string valueStr)
    {
        if (valueStr.EndsWith("%"))
        {
            return double.TryParse(valueStr.TrimEnd('%'), out double percentValue) ? percentValue : 0;
        }

        return double.TryParse(valueStr, out double numValue) ? numValue : 0;
    }

    /// <summary>
    /// 格式化输出区的属性值显示：百分比数值属性（首领克制/灵韵）带 % 后缀，其余为普通数值
    /// </summary>
    private string FormatInputValue(KiUpdateResult result)
    {
        // 百分比数值属性（如 1.1 表示 1.1%），加 % 后缀与输入区一致
        return result.IsPercent ? $"{result.InputValue}%" : result.InputValue.ToString();
    }

    private void SaveInfo()
    {
        LocalStorage.SetItem(nameof(_kiUpdatePageModel), _kiUpdatePageModel);
    }

    private void ShowTips()
    {
        Dialog.Show<TipsDialog>("帮助说明", _tipsDialogParameters, _tipsDialogOptions);
    }

    /// <summary>
    /// 打开图片识别弹窗。弹窗自己注入 WebOcrEngine（Scoped）并管理引擎状态/进度，
    /// 故本组件只需传入「当前标签页」用于决定识别文本回写目标。
    /// 引擎实例仍为 Scoped 共享，关闭弹窗不释放（满足实例开销顾虑）。
    /// </summary>
    private void OpenOcrImageDialog()
    {
        var parameters = new DialogParameters<OcrImageDialog>
        {
            { x => x.ActiveOcrTab, _activeOcrTab },
            { x => x.OnRecognized, EventCallback.Factory.Create<string>(this, OnOcrRecognizedAsync) },
        };
        var options = new DialogOptions { CloseButton = true, CloseOnEscapeKey = true };
        Dialog.Show<OcrImageDialog>("图片识别", parameters, options);
    }

    /// <summary>
    /// 弹窗识别完成后回调：把文本写入当前激活的 OCR 标签页对应文本框，并复用现有解析逻辑填入对应列。
    /// 0=填写数值识别，1=上限收益率识别。
    /// </summary>
    private Task OnOcrRecognizedAsync(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            Snackbar.Add("未识别到文字，请尝试更清晰的截图或调整框选范围", Severity.Warning);
            return Task.CompletedTask;
        }

        if (_activeOcrTab == 0)
        {
            _ocrFillText = text;
            OnRecognizeFill();
        }
        else
        {
            _ocrRateText = text;
            OnRecognizeRate();
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// 单属性实际收益率计算结果
    /// </summary>
    private class KiUpdateResult
    {
        public string Name { get; set; }
        /// <summary>
        /// 填写的属性数值（首领克制/灵韵为百分数值，如 1.1）
        /// </summary>
        public double InputValue { get; set; }
        public double ActualRate { get; set; }
        /// <summary>是否为百分比数值属性（显示时加 % 后缀）</summary>
        public bool IsPercent { get; set; }

        public KiUpdateResult(string name, double inputValue, double actualRate, bool isPercent = false)
        {
            Name = name;
            InputValue = inputValue;
            ActualRate = actualRate;
            IsPercent = isPercent;
        }
    }
}
