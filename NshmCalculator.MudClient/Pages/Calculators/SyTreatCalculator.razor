@page "/syTreat"
@using System.Text.Json
@using Blazored.LocalStorage
@using NshmCalculator.MudClient.Components.Dialog
@using NshmCalculator.MudClient.Utilities
@using NshmCalculator.Shared
@using NshmCalculator.Shared.Models.CalculatorModel
@using NshmCalculator.Shared.Models.CalculatorModel.CalculatorConfig
@using NshmCalculator.Shared.Models.PageModel
@using Align = MudBlazor.Align
@using Color = MudBlazor.Color
@inject ISyncLocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject HttpClient Client

<PageTitle>素问治疗计算器</PageTitle>

<MudGrid>
    @if (renderNotComplete)
    {
        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <MudSkeleton/>
                <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Height="100px"/>
                <MudSkeleton/>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <MudSkeleton/>
                <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Height="300px"/>
                <MudSkeleton/>
            </MudPaper>
        </MudItem>
    }
    else
    {
        <MudItem xs="12">
            <MudPaper Class="d-flex align-center justify-center py-8">
                <MudStack AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h4">素问治疗计算器</MudText>
                    <MudText Typo="Typo.h6" Align="Align.Center">
                        <MudChip Icon="@Icons.Material.Filled.Person" Color="Color.Tertiary">小红书/抖音:师尹</MudChip>
                        <MudChip Color="Color.Info">源文件版本:@_currentConfig.Version</MudChip>
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <EditForm Model="_treatPageModel" OnValidSubmit="Calculate" OnInvalidSubmit="WarningTips">
                    <ObjectGraphDataAnnotationsValidator/>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Align="Align.Center">基础治疗面板</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.BaseTreatInfo.Attack"
                                          For="@(() => _treatPageModel.BaseTreatInfo.Attack)" Label="攻击" Variant="Variant.Outlined"
                                          Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.BaseTreatInfo.TreatIntensity"
                                          For="@(() => _treatPageModel.BaseTreatInfo.TreatIntensity)" Label="治疗强度" Variant="Variant.Outlined"
                                          Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.BaseTreatInfo.CriticalHits"
                                          For="@(() => _treatPageModel.BaseTreatInfo.CriticalHits)" Label="会心" Variant="Variant.Outlined"
                                          Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.BaseTreatInfo.CriticalDamageRate"
                                          For="@(() => _treatPageModel.BaseTreatInfo.CriticalDamageRate)" Adornment="Adornment.End" AdornmentText="%"
                                          AdornmentColor="Color.Dark" Label="会伤百分比" HelperText="在详细面板中查看，填入会伤时无需减半"
                                          Variant="Variant.Outlined" Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.BaseTreatInfo.ZtCriticalHitsRate"
                                          For="@(() => _treatPageModel.BaseTreatInfo.ZtCriticalHitsRate)" Adornment="Adornment.End" AdornmentText="%"
                                          AdornmentColor="Color.Dark" Label="金周天会心率" HelperText="内功元素中1金周天加的会心率"
                                          Variant="Variant.Outlined" Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                        </MudItem>
                        <MudItem xs="12" Class="d-flex align-center justify-center">
                            <MudStack Row="true" Spacing="4">
                                <MudChip Color="Color.Info">
                                    基础面板会心率：@_treatPageModel.BaseTreatInfo.CalculateCriticalHitsRate.ToString("P2")</MudChip>
                                <MudChip Color="Color.Info">基础面板治疗量：@_treatPageModel.BaseTreatInfo.CalculateTreatNum.ToString("F3")</MudChip>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6"
                                     @bind-ActivePanelIndex="_treatPageModel.ActiveIndex">
                                <MudTabPanel Text="属性变化计算">
                                    <MudGrid>
                                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.Attack" For="@(() => _treatPageModel.Attack)"
                                                          Label="攻击" Variant="Variant.Outlined"
                                                          Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.TreatIntensity"
                                                          For="@(() => _treatPageModel.TreatIntensity)" Label="治疗强度" Variant="Variant.Outlined"
                                                          Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.CriticalDamageRate"
                                                          For="@(() => _treatPageModel.CriticalDamageRate)" Adornment="Adornment.End"
                                                          AdornmentText="%" AdornmentColor="Color.Dark" Label="会伤百分比"
                                                          Variant="Variant.Outlined" Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.CriticalHitsRate"
                                                          For="@(() => _treatPageModel.CriticalHitsRate)" Adornment="Adornment.End" AdornmentText="%"
                                                          AdornmentColor="Color.Dark" Label="会心率" Variant="Variant.Outlined"
                                                          Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.CriticalHits"
                                                          For="@(() => _treatPageModel.CriticalHits)" Label="会心" Variant="Variant.Outlined"
                                                          Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                        </MudItem>
                                        <MudItem xs="12" Class="d-flex align-center justify-center">
                                            <MudStack Row="true" Spacing="4">
                                                <MudChip Color="Color.Info">
                                                    变化后会心率：@_treatPageModel.CalculateCriticalHitsRate.ToString("P2")</MudChip>
                                                <MudChip Color="Color.Info">变化后治疗量：@_treatPageModel.CalculateTreatNum.ToString("F3")</MudChip>
                                            </MudStack>
                                        </MudItem>
                                    </MudGrid>
                                </MudTabPanel>
                                <MudTabPanel Text="新面板计算">
                                    <MudGrid>
                                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.DifferenceTreatInfo.Attack"
                                                          For="@(() => _treatPageModel.DifferenceTreatInfo.Attack)" Label="攻击"
                                                          Variant="Variant.Outlined" Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.DifferenceTreatInfo.TreatIntensity"
                                                          For="@(() => _treatPageModel.DifferenceTreatInfo.TreatIntensity)" Label="治疗强度"
                                                          Variant="Variant.Outlined" Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.DifferenceTreatInfo.CriticalHits"
                                                          For="@(() => _treatPageModel.DifferenceTreatInfo.CriticalHits)" Label="会心"
                                                          Variant="Variant.Outlined" Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.DifferenceTreatInfo.CriticalDamageRate"
                                                          For="@(() => _treatPageModel.DifferenceTreatInfo.CriticalDamageRate)"
                                                          Adornment="Adornment.End" AdornmentText="%" AdornmentColor="Color.Dark" Label="会伤百分比"
                                                          Variant="Variant.Outlined" Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                            <MudTextField ShrinkLabel @bind-Value="_treatPageModel.DifferenceTreatInfo.ZtCriticalHitsRate"
                                                          For="@(() => _treatPageModel.DifferenceTreatInfo.ZtCriticalHitsRate)"
                                                          Adornment="Adornment.End" AdornmentText="%" AdornmentColor="Color.Dark" Label="金周天会心率"
                                                          Variant="Variant.Outlined" Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                        </MudItem>
                                        <MudItem xs="12" Class="d-flex align-center justify-center">
                                            <MudStack Row="true" Spacing="4">
                                                <MudChip Color="Color.Info">
                                                    新面板会心率：@_treatPageModel.DifferenceTreatInfo.CalculateCriticalHitsRate.ToString("P2")</MudChip>
                                                <MudChip Color="Color.Info">
                                                    新面板治疗量：@_treatPageModel.DifferenceTreatInfo.CalculateTreatNum.ToString("F3")</MudChip>
                                            </MudStack>
                                        </MudItem>
                                    </MudGrid>
                                </MudTabPanel>
                                <MudTabPanel Text="转换疗强计算">
                                    <MudGrid>
                                        @if (_currentConfig.TransTreatFields?.Length > 0)
                                        {
                                            foreach (var treatField in _currentConfig.TransTreatFields)
                                            {
                                                <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                                    <MudTextField ShrinkLabel @bind-Value="@treatField.Value" For="@(() => @treatField.Value)"
                                                                  Label="@treatField.Name" Variant="Variant.Outlined"
                                                                  Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                                </MudItem>
                                            }
                                        }
                                        <MudItem xs="12">
                                            <MudAlert Severity="Severity.Info">转换疗强计算结果与基础面板无关</MudAlert>
                                        </MudItem>
                                    </MudGrid>
                                </MudTabPanel>
                                <MudTabPanel Text="pvp词条收益">
                                    <MudGrid>
                                        <MudItem xs="12">
                                            <MudAlert Severity="Severity.Info">
                                                气血”不计算在内功主词条中“气血上限”的值；格挡类词条需面板格挡在3000以上才填。疗承比根据个人理解填入你认为1%治疗提升=X%坦度提升，X越低说明坦度越重要
                                            </MudAlert>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudExpansionPanels MultiExpansion="true">
                                                @if (_currentConfig.ScoreFields?.Length > 0)
                                                {
                                                    var result = _currentConfig.ScoreFields.GroupBy(s => s.BelongGroup);
                                                    foreach (IGrouping<string, FieldInfo> fieldResults in result)
                                                    {
                                                        <MudExpansionPanel Text=@fieldResults.Key>
                                                            <MudGrid>
                                                                @foreach (var fieldResult in fieldResults)
                                                                {
                                                                    <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                                                        <MudTextField ShrinkLabel @bind-Value="@fieldResult.Value"
                                                                                      For="@(() => fieldResult.Value)" Label="@fieldResult.Name"
                                                                                      Adornment="@(fieldResult.PercentMode ? Adornment.End : Adornment.None)"
                                                                                      AdornmentText="%" AdornmentColor="Color.Dark"
                                                                                      Variant="Variant.Outlined"
                                                                                      Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                                                    </MudItem>
                                                                }
                                                            </MudGrid>
                                                        </MudExpansionPanel>
                                                    }
                                                }
                                            </MudExpansionPanels>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudTextField ShrinkLabel @bind-Value="@_treatPageModel.TreatDefenseRatio"
                                                          Label="疗承比" HelperText="详情查阅“帮助说明”底部" Variant="Variant.Outlined"
                                                          Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudSelect Label="灵韵内功" Variant="Variant.Outlined" @bind-Value="_selectedKey"
                                                       TextChanged="OnSelectionChanged" Margin="@(_denseMode ? Margin.Dense : Margin.Normal)">
                                                @if (_currentConfig.SpecialScoreDictionary?.Count > 0)
                                                {
                                                    foreach (var keyValuePair in _currentConfig.SpecialScoreDictionary)
                                                    {
                                                        <MudSelectItem Value="@keyValuePair">@keyValuePair.Key</MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>
                                </MudTabPanel>
                            </MudTabs>
                        </MudItem>
                        <MudItem xs="12" Class="d-flex align-center justify-center">
                            <MudStack Row="true" Spacing="4">
                                @switch (_treatPageModel.ActiveIndex)
                                {
                                    case 0:
                                    case 1:
                                        <MudChip Color="Color.Info">治疗量增值：@_treatPageModel.TreatGrowthNum.ToString("F3")</MudChip>
                                        <MudChip Color="Color.Info">收益百分比：@_treatPageModel.TreatGrowthPercent.ToString("P2")</MudChip>
                                        break;
                                    case 2:
                                        <MudChip
                                            Color="Color.Success">转换疗强：@_treatPageModel.ConvertTreatNum.ToString("F2")</MudChip>
                                        break;
                                    case 3:
                                        <MudChip Color="Color.Info">灵韵分（不记总评分）：@_treatPageModel.SpecialScoreText</MudChip>
                                        <MudChip
                                            Color="Color.Success">总评分：@_treatPageModel.Score.ToString("F3")</MudChip>
                                        break;
                                }
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12">
                            <MudDivider FlexItem="true"/>
                        </MudItem>
                        <MudItem xs="12" Class="d-flex align-center justify-center">
                            <MudStack Row="true" Spacing="4">
                                <MudButton Variant="Variant.Filled" Color="Color.Info" Class="d-flex" ButtonType="ButtonType.Submit">计算</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Default" Class="d-flex" ButtonType="ButtonType.Button"
                                           OnClick="ShowTips">帮助说明
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </EditForm>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private readonly DialogParameters<TipsDialog> _tipsDialogParameters = new();
    private readonly DialogOptions _tipsDialogOptions = new();
    private SyTreatPageModel _treatPageModel = new();
    private SyTreatConfig _currentConfig;
    readonly TreatInfo _additionalInfo = new();
    private KeyValuePair<string, string> _selectedKey { get; set; }
    private Func<KeyValuePair<string, string>, string> convertFunc = ci => ci.Key;
    private bool renderNotComplete { get; set; }
    private bool _denseMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        renderNotComplete = true;
        _denseMode = LocalStorage.GetItem<bool>(ConstText.DenseModeName);
        await LoadData();
        await base.OnInitializedAsync();
        InitParameters();
        GetInfo();
        LocalStorage.SetItemAsString(ConstText.LastVisitName, "syTreat");
    }

    private async Task<bool> LoadData()
    {
        try
        {
            _treatPageModel = LocalStorage.GetItem<SyTreatPageModel>(nameof(_treatPageModel)) ?? new();
        }
        catch (Exception e)
        {
            Console.WriteLine("身份收益计算器缓存加载异常" + e);
            _treatPageModel = new SyTreatPageModel();
        }

        var result = await ConfigHelper.GetConfigJson(Client, "syTreat", LocalStorage);
        if (result.Item1 == ConstText.NotExistText)
        {
            Snackbar.Add(result.Item1, Severity.Error);
        }
        else
        {
            try
            {
                _currentConfig = JsonSerializer.Deserialize<SyTreatConfig>(result.Item1);
                if (result.Item2)
                {
                    Snackbar.Add("配置数据更新，已加载完成", Severity.Success);
                }

                renderNotComplete = false;
            }
            catch (Exception e)
            {
                Console.WriteLine(e);
                Snackbar.Add("解析配置时出现异常，请检查网络");
            }
        }

        return result.Item2;
    }

    private void GetInfo()
    {
        _treatPageModel.TransTreatFields = _currentConfig.TransTreatFields;
        _treatPageModel.ScoreFields = _currentConfig.ScoreFields;
        if (_treatPageModel.TransTreatDictionary is { Count: > 0 }) //恢复保存的数值
        {
            foreach ((string? key, int value) in _treatPageModel.TransTreatDictionary)
            {
                if (_treatPageModel.TransTreatFields.FirstOrDefault(s => s.Name == key) is FieldInfo info)
                {
                    info.Value = value;
                }
            }
        }

        if (_treatPageModel.ScoreFieldsDictionary is { Count: > 0 })
        {
            foreach ((string? key, int value) in _treatPageModel.ScoreFieldsDictionary)
            {
                if (_treatPageModel.ScoreFields.FirstOrDefault(s => s.Name == key) is FieldInfo info)
                {
                    info.Value = value;
                }
            }
        }

        if (string.IsNullOrEmpty(_treatPageModel.SelectedKey) || !_currentConfig.SpecialScoreDictionary.ContainsKey(_treatPageModel.SelectedKey))
        {
            _selectedKey = _currentConfig.SpecialScoreDictionary.First();
        }
        else
        {
            _selectedKey = _currentConfig.SpecialScoreDictionary.First(s => s.Key == _treatPageModel.SelectedKey);
        }
    }

    private void SaveInfo()
    {
        LocalStorage.SetItem(nameof(_treatPageModel), _treatPageModel);
    }

    private void Calculate()
    {
        switch (_treatPageModel.ActiveIndex)
        {
            case 0:
                AdditionalCalculate();
                break;
            case 1:
                CompareCalculate();
                break;
            case 2:
                ConvertTreatNumCalculate();
                break;
            case 3:
                ScoreCalculate();
                break;
        }

        SaveInfo();
    }

    private void AdditionalCalculate()
    {
        _additionalInfo.Attack = _treatPageModel.BaseTreatInfo.Attack + _treatPageModel.Attack;
        _additionalInfo.TreatIntensity = _treatPageModel.BaseTreatInfo.TreatIntensity + _treatPageModel.TreatIntensity;
        _additionalInfo.CriticalDamageRate = _treatPageModel.BaseTreatInfo.CriticalDamageRate + _treatPageModel.CriticalDamageRate;
        _additionalInfo.CriticalHits = _treatPageModel.BaseTreatInfo.CriticalHits + _treatPageModel.CriticalHits;
        _additionalInfo.ZtCriticalHitsRate = _treatPageModel.BaseTreatInfo.ZtCriticalHitsRate;
        _additionalInfo.ExtraCriticalHitsRate = _treatPageModel.CriticalHitsRate / 100;

        (_treatPageModel.TreatGrowthNum, _treatPageModel.TreatGrowthPercent) = TreatUtility.Compare(_treatPageModel.BaseTreatInfo, _additionalInfo, _currentConfig);
        _treatPageModel.CalculateCriticalHitsRate = _additionalInfo.CalculateCriticalHitsRate;
        _treatPageModel.CalculateTreatNum = _additionalInfo.CalculateTreatNum;
        _treatPageModel.ConvertMode = false;

        Snackbar.Add(ConstText.SuccessText, Severity.Success);
    }

    private void CompareCalculate()
    {
        (_treatPageModel.TreatGrowthNum, _treatPageModel.TreatGrowthPercent) = TreatUtility.Compare(_treatPageModel.BaseTreatInfo, _treatPageModel.DifferenceTreatInfo, _currentConfig);

        _treatPageModel.ConvertMode = false;

        Snackbar.Add(ConstText.SuccessText, Severity.Success);
    }

    private void ConvertTreatNumCalculate()
    {
        _treatPageModel.ConvertTreatNum = TreatUtility.FieldCalculate(_treatPageModel.TransTreatFields, 1);

        _treatPageModel.ConvertMode = true;

        _treatPageModel.TransTreatDictionary = _treatPageModel.TransTreatFields.ToDictionary(s => s.Name, s => s.Value);

        Snackbar.Add(ConstText.SuccessText, Severity.Success);
    }

    private void ScoreCalculate()
    {
        _treatPageModel.Score = TreatUtility.FieldCalculate(_treatPageModel.ScoreFields, _treatPageModel.TreatDefenseRatio);
        _treatPageModel.SelectedKey = _selectedKey.Key;

        _treatPageModel.ConvertMode = true;

        _treatPageModel.ScoreFieldsDictionary = _treatPageModel.ScoreFields.ToDictionary(s => s.Name, s => s.Value);

        Snackbar.Add(ConstText.SuccessText, Severity.Success);
    }

    private void InitParameters()
    {
        _tipsDialogParameters.Add(nameof(TipsDialog.ContentText), new MarkupString(_currentConfig.HelperText));
        _tipsDialogOptions.CloseButton = true;

        if (_currentConfig.Version == "0.0")
        {
            Snackbar.Add(ConstText.ConfigNotFoundText, Severity.Warning);
        }
    }

    private Task WarningTips()
    {
        Snackbar.Add(ConstText.WarningText, Severity.Warning);

        return Task.CompletedTask;
    }

    private void ShowTips()
    {
        Dialog.Show<TipsDialog>("帮助说明", _tipsDialogParameters, _tipsDialogOptions);
    }

    private void OnSelectionChanged()
    {
        int index = Array.IndexOf(_currentConfig.ExceptSpecialScoreArray, _selectedKey.Key);
        if (index >= 0)
        {
            _treatPageModel.SpecialScoreText = (Convert.ToDouble(_selectedKey.Value) / _treatPageModel.TreatDefenseRatio).ToString("F2");
        }
        else
        {
            _treatPageModel.SpecialScoreText = _selectedKey.Value;
        }
    }

}