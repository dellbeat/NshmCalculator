@page "/syTreat"
@using Blazored.LocalStorage
@using NshmCalculator.MudClient.Components
@using NshmCalculator.MudClient.Utilities
@using NshmCalculator.Shared
@using NshmCalculator.Shared.Models.BaseModel
@using NshmCalculator.Shared.Models.CalculatorModel
@using NshmCalculator.Shared.Models.PageModel
@using Color = MudBlazor.Color
@inject ISyncLocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject Dictionary<string, string> TipsDictionary
@inject GameData GameConfig
<PageTitle>素问治疗计算器</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="d-flex align-center justify-center py-8">
            <MudStack AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">素问治疗计算器</MudText>
                <MudText Typo="Typo.h6" Align="MudBlazor.Align.Center">
                    <MudChip Icon="@Icons.Material.Filled.Person" Color="MudBlazor.Color.Tertiary">小红书/抖音:师尹</MudChip>
                    <MudChip Color="Color.Info">源文件版本:@_currentConfig.Version</MudChip>
                </MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-4 mt-4">
            <EditForm Model="_treatPageModel" OnValidSubmit="Calculate" OnInvalidSubmit="WarningTips">
                <ObjectGraphDataAnnotationsValidator />
                <MudGrid>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Align="MudBlazor.Align.Center">基础治疗面板</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.BaseTreatInfo.Attack" For="@(() => _treatPageModel.BaseTreatInfo.Attack)" Label="攻击" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.BaseTreatInfo.TreatIntensity" For="@(() => _treatPageModel.BaseTreatInfo.TreatIntensity)" Label="治疗强度" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.BaseTreatInfo.CriticalHits" For="@(() => _treatPageModel.BaseTreatInfo.CriticalHits)" Label="会心" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.BaseTreatInfo.CriticalDamageRate" For="@(() => _treatPageModel.BaseTreatInfo.CriticalDamageRate)" Adornment="Adornment.End" AdornmentText="%" AdornmentColor="Color.Dark" Label="会伤百分比" HelperText="在详细面板中查看，填入会伤时无需减半" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.BaseTreatInfo.ZtCriticalHitsRate" For="@(() => _treatPageModel.BaseTreatInfo.ZtCriticalHitsRate)" Adornment="Adornment.End" AdornmentText="%" AdornmentColor="Color.Dark" Label="金周天会心率" HelperText="内功元素中1金周天加的会心率" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" Class="d-flex align-center justify-center">
                        <MudStack Row="true" Spacing="4">
                            <MudChip Color="Color.Info">基础面板会心率：@_treatPageModel.BaseTreatInfo.CalculateCriticalHitsRate.ToString("P2")</MudChip>
                            <MudChip Color="Color.Info">基础面板治疗量：@_treatPageModel.BaseTreatInfo.CalculateTreatNum.ToString("F3")</MudChip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTabs @bind-ActivePanelIndex="_treatPageModel.ActiveIndex" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                            <MudTabPanel Text="属性变化计算">
                                <MudGrid>
                                    <MudItem xs="6" sm="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.Attack" For="@(() => _treatPageModel.Attack)" Label="攻击" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="6" sm="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.TreatIntensity" For="@(() => _treatPageModel.TreatIntensity)" Label="治疗强度" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="6" sm="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.CriticalDamageRate" For="@(() => _treatPageModel.CriticalDamageRate)" Adornment="Adornment.End" AdornmentText="%" AdornmentColor="Color.Dark" Label="会伤百分比" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="6" sm="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.CriticalHitsRate" For="@(() => _treatPageModel.CriticalHitsRate)" Adornment="Adornment.End" AdornmentText="%" AdornmentColor="Color.Dark" Label="会心率" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="6" sm="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.CriticalHits" For="@(() => _treatPageModel.CriticalHits)" Label="会心" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="12" Class="d-flex align-center justify-center">
                                        <MudStack Row="true" Spacing="4">
                                            <MudChip Color="Color.Info">变化后会心率：@_treatPageModel.CalculateCriticalHitsRate.ToString("P2")</MudChip>
                                            <MudChip Color="Color.Info">变化后治疗量：@_treatPageModel.CalculateTreatNum.ToString("F3")</MudChip>
                                        </MudStack>
                                    </MudItem>
                                </MudGrid>
                            </MudTabPanel>
                            <MudTabPanel Text="新面板计算">
                                <MudGrid>
                                    <MudItem xs="6" sm="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.DifferenceTreatInfo.Attack" For="@(() => _treatPageModel.DifferenceTreatInfo.Attack)" Label="攻击" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="6" sm="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.DifferenceTreatInfo.TreatIntensity" For="@(() => _treatPageModel.DifferenceTreatInfo.TreatIntensity)" Label="治疗强度" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="6" sm="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.DifferenceTreatInfo.CriticalHits" For="@(() => _treatPageModel.DifferenceTreatInfo.CriticalHits)" Label="会心" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="6" sm="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.DifferenceTreatInfo.CriticalDamageRate" For="@(() => _treatPageModel.DifferenceTreatInfo.CriticalDamageRate)" Adornment="Adornment.End" AdornmentText="%" AdornmentColor="Color.Dark" Label="会伤百分比" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="6" sm="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.DifferenceTreatInfo.ZtCriticalHitsRate" For="@(() => _treatPageModel.DifferenceTreatInfo.ZtCriticalHitsRate)" Adornment="Adornment.End" AdornmentText="%" AdornmentColor="Color.Dark" Label="金周天会心率" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="12" Class="d-flex align-center justify-center">
                                        <MudStack Row="true" Spacing="4">
                                            <MudChip Color="Color.Info">新面板会心率：@_treatPageModel.DifferenceTreatInfo.CalculateCriticalHitsRate.ToString("P2")</MudChip>
                                            <MudChip Color="Color.Info">新面板治疗量：@_treatPageModel.DifferenceTreatInfo.CalculateTreatNum.ToString("F3")</MudChip>
                                        </MudStack>
                                    </MudItem>
                                </MudGrid>
                            </MudTabPanel>
                            <MudTabPanel Text="转换疗强计算">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.TreatAttribution.Attack" For="@(() => _treatPageModel.TreatAttribution.Attack)" Label="攻击" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.TreatAttribution.Strength" For="@(() => _treatPageModel.TreatAttribution.Strength)" Label="气海" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.TreatAttribution.HalfAttackSum" For="@(() => _treatPageModel.TreatAttribution.HalfAttackSum)" Label="大小攻" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.TreatAttribution.BreakDefense" For="@(() => _treatPageModel.TreatAttribution.BreakDefense)" Label="破防" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.TreatAttribution.ElementAttack" For="@(() => _treatPageModel.TreatAttribution.ElementAttack)" Label="元素攻击" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.TreatAttribution.MonsterRestraint" For="@(() => _treatPageModel.TreatAttribution.MonsterRestraint)" Label="首领克制" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.TreatAttribution.Hit" For="@(() => _treatPageModel.TreatAttribution.Hit)" Label="命中" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.TreatAttribution.Hit" For="@(() => _treatPageModel.TreatAttribution.Hit)" Label="忽视元素抗" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudTextField ShrinkLabel @bind-Value="_treatPageModel.TreatAttribution.MonsterRestraint" For="@(() => _treatPageModel.TreatAttribution.MonsterRestraint)" Label="流派克制" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudAlert Severity="Severity.Info">转换疗强计算结果与基础面板无关</MudAlert>
                                    </MudItem>
                                </MudGrid>
                            </MudTabPanel>
                        </MudTabs>
                    </MudItem>
                    <MudItem xs="12" Class="d-flex align-center justify-center">
                        <MudStack Row="true" Spacing="4">
                            @if (_treatPageModel.ConvertMode)
                            {
                                <MudChip Color="Color.Success">转换疗强：@_treatPageModel.ConvertTreatNum.ToString("F2")</MudChip>
                            }
                            else
                            {
                                <MudChip Color="Color.Info">治疗量增值：@_treatPageModel.TreatGrowthNum.ToString("F3")</MudChip>
                                <MudChip Color="Color.Info">收益百分比：@_treatPageModel.TreatGrowthPercent.ToString("P2")</MudChip>
                            }
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12">
                        <MudDivider FlexItem="true" />
                    </MudItem>
                    <MudItem xs="12" Class="d-flex align-center justify-center">
                        <MudStack Row="true" Spacing="4">
                            <MudButton Variant="Variant.Filled" Color="Color.Info" Class="d-flex" ButtonType="ButtonType.Submit">计算</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Default" Class="d-flex" ButtonType="ButtonType.Button" OnClick="ShowTips">帮助说明</MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private readonly DialogParameters<TipsDialog> _tipsDialogParameters = new();
    private readonly DialogOptions _tipsDialogOptions = new();
    private SyTreatPageModel _treatPageModel = new();
    private SyTreatConfig _currentConfig;
    readonly TreatInfo _additionalInfo = new TreatInfo();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        InitParameters();
        GetInfo();
        LocalStorage.SetItemAsString(ConstText.LastVisitName, "syTreat");
    }

    private void GetInfo()
    {
        _treatPageModel = LocalStorage.GetItem<SyTreatPageModel>(nameof(_treatPageModel)) ?? new();
    }

    private void SaveInfo()
    {
        LocalStorage.SetItem(nameof(_treatPageModel), _treatPageModel);
    }

    private void Calculate()
    {
        switch (_treatPageModel.ActiveIndex)
        {
            case 0:
                AdditionalCalculate();
                break;
            case 1:
                CompareCalculate();
                break;
            case 2:
                ConvertTreatNumCalculate();
                break;
        }

        SaveInfo();
    }

    private void AdditionalCalculate()
    {
        _additionalInfo.Attack = _treatPageModel.BaseTreatInfo.Attack + _treatPageModel.Attack;
        _additionalInfo.TreatIntensity = _treatPageModel.BaseTreatInfo.TreatIntensity + _treatPageModel.TreatIntensity;
        _additionalInfo.CriticalDamageRate = _treatPageModel.BaseTreatInfo.CriticalDamageRate + _treatPageModel.CriticalDamageRate;
        _additionalInfo.CriticalHits = _treatPageModel.BaseTreatInfo.CriticalHits + _treatPageModel.CriticalHits;
        _additionalInfo.ZtCriticalHitsRate = _treatPageModel.BaseTreatInfo.ZtCriticalHitsRate;
        _additionalInfo.ExtraCriticalHitsRate =  _treatPageModel.CriticalHitsRate / 100;

        (_treatPageModel.TreatGrowthNum, _treatPageModel.TreatGrowthPercent) = TreatUtility.Compare(_treatPageModel.BaseTreatInfo, _additionalInfo, _currentConfig);
        _treatPageModel.CalculateCriticalHitsRate = _additionalInfo.CalculateCriticalHitsRate;
        _treatPageModel.CalculateTreatNum = _additionalInfo.CalculateTreatNum;
        _treatPageModel.ConvertMode = false;

        Snackbar.Add(ConstText.SuccessText, Severity.Success);
    }

    private void CompareCalculate()
    {
        (_treatPageModel.TreatGrowthNum, _treatPageModel.TreatGrowthPercent) = TreatUtility.Compare(_treatPageModel.BaseTreatInfo, _treatPageModel.DifferenceTreatInfo,_currentConfig);

        _treatPageModel.ConvertMode = false;

        Snackbar.Add(ConstText.SuccessText, Severity.Success);
    }

    private void ConvertTreatNumCalculate()
    {
        _treatPageModel.ConvertTreatNum = TreatUtility.TransformCalculate(_treatPageModel.TreatAttribution);

        _treatPageModel.ConvertMode = true;

        Snackbar.Add(ConstText.SuccessText, Severity.Success);
    }

    private void InitParameters()
    {
        TipsDictionary.TryGetValue("syTreat", out string? tips);
        _currentConfig = GameConfig.SyTreatConfig.Length > 0 ? GameConfig.SyTreatConfig[0] : new SyTreatConfig() { Version = "0.0" };
        _tipsDialogParameters.Add(nameof(TipsDialog.ContentText), new MarkupString(tips));
        _tipsDialogOptions.CloseButton = true;

        if (_currentConfig.Version == "0.0")
        {
            Snackbar.Add("获取计算器配置时出现异常，请检查网络", Severity.Warning);
        }
    }

    private Task WarningTips()
    {
        Snackbar.Add(ConstText.WarningText, Severity.Warning);

        return Task.CompletedTask;
    }

    private void ShowTips()
    {
        Dialog.Show<TipsDialog>("帮助说明", _tipsDialogParameters, _tipsDialogOptions);
    }

}