@page "/sf"
@using System.Collections.ObjectModel
@using System.Text.Json
@using Blazored.LocalStorage
@using NshmCalculator.MudClient.Components.Dialog
@using NshmCalculator.MudClient.Utilities
@using NshmCalculator.Shared
@using NshmCalculator.Shared.Models.CalculatorModel.CalculatorConfig
@using NshmCalculator.Shared.Models.CalculatorModel.FormulaParam.Formula
@using NshmCalculator.Shared.Models.CalculatorModel.FormulaParam.Params
@using NshmCalculator.Shared.Models.PageModel
@using Align = MudBlazor.Align
@using Color = MudBlazor.Color
@inject ISyncLocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject HttpClient Client

<PageTitle>逆水寒手游身份收益计算器</PageTitle>

<MudGrid>
    @if (!renderNotComplete)
    {
        <MudItem xs="12">
            <MudPaper Class="d-flex align-center justify-center py-8">
                <MudStack AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h4">身份收益计算器</MudText>
                    <MudText Typo="Typo.h6" Align="Align.Center">
                        <MudChip Icon="@Icons.Material.Filled.Person" Color="Color.Tertiary">B站@逆水寒-夜银</MudChip>
                        <MudChip Color="Color.Info">源文件版本:@_currentConfig.Version</MudChip>
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <EditForm Model="_occupationPageModel.GoodsArray" OnInvalidSubmit="WarningTips">
                    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Centered="true">
                        @if (_occupationPageModel.GoodsArray?.Length > 0)
                        {
                            var groupedGoods = _occupationPageModel.GoodsArray.GroupBy(s => s.BelongGroup);
                            foreach (var group in groupedGoods)
                            {
                                <MudTabPanel Text="@group.Key">
                                    <MudGrid>
                                        @foreach (var item in group)
                                        {
                                            <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                                                <MudTextField ShrinkLabel @bind-Value="@item.Price" For="@(() => item.Price)" Label="@item.Name"
                                                              Variant="Variant.Outlined"  Margin="@(_denseMode ? Margin.Dense : Margin.Normal)"/>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudTabPanel>
                            }
                        }
                    </MudTabs>
                </EditForm>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <MudTabs KeepPanelsAlive="true" Elevation="2" ApplyEffectsToContainer="true" PanelClass="pa-6" Centered="true">
                    <MudTabPanel Text="身份收益列表">
                        <MudTable FixedHeader="true" T="OccupationFormulas" Items="@_observableFormulas" Breakpoint="Breakpoint.None" Striped="true"
                                  Dense="true" OnRowClick="OnRowClick">
                            <ToolBarContent>
                                <MudTextField @bind-Value="Keyword" Label="关键词" Variant="Variant.Outlined" Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Info" Margin="Margin.Dense"
                                              OnAdornmentClick="OnSearch"/>
                            </ToolBarContent>
                            <HeaderContent>
                                <MudTh>商品</MudTh>
                                <MudTh>
                                    <MudTableSortLabel SortBy="new Func<OccupationFormulas, object>(x => x.Value)">
                                        10活力收益
                                    </MudTableSortLabel>
                                </MudTh>
                                <MudTh>收藏</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="商品">@context.GoodsName</MudTd>
                                <MudTd DataLabel="10活力收益">@context.Value.ToString("F2")</MudTd>
                                <MudTd DataLabel="收藏">
                                    @if (context.Favorite)
                                    {
                                        <MudIconButton OnClick="() => OnClickFavorite(context)" Icon="@Icons.Material.Filled.Favorite"
                                                       Color="@Color.Info"/>
                                    }
                                    else
                                    {
                                        <MudIconButton OnClick="() => OnClickFavorite(context)" Icon="@Icons.Material.Filled.FavoriteBorder"
                                                       Color="@Color.Info"/>
                                    }
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new[] { 10 }"
                                               HideRowsPerPage="true"/>
                            </PagerContent>
                        </MudTable>
                    </MudTabPanel>
                    <MudTabPanel Text="收藏夹">
                        <MudPaper Style="max-height:800px;overflow-y:auto;overflow-x: hidden">
                            <MudGrid>
                                @foreach (var favoriteItem in FavoriteFormulas)
                                {
                                    <MudItem xs="12" sm="6" md="4" lg="3" xl="3">
                                        <MudCard>
                                            <MudCardHeader>
                                                <CardHeaderContent>
                                                    <MudText Typo="Typo.h6">@favoriteItem.GoodsName</MudText>
                                                </CardHeaderContent>
                                                <CardHeaderActions>
                                                    <MudStack Row="true">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info"
                                                                       OnClick="() => ShowFormula(favoriteItem)"/>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Favorite" Color="Color.Info"
                                                                       OnClick="() => OnClickFavorite(favoriteItem, true)"/>
                                                    </MudStack>
                                                </CardHeaderActions>
                                            </MudCardHeader>
                                            <MudCardContent>
                                                <MudStack Row="true">
                                                    <MudChip T="string" Color="Color.Info">收益</MudChip>
                                                    <MudText Typo="Typo.body2" Class="mt-3">@favoriteItem.Value.ToString("F2")</MudText>
                                                </MudStack>
                                                <MudStack Row="true">
                                                    <MudChip T="string" Color="Color.Info">备注</MudChip>
                                                    <MudText Typo="Typo.body2" Class="mt-3">
                                                        @(string.IsNullOrEmpty(favoriteItem.Remark) ? "无" : favoriteItem.Remark)
                                                    </MudText>
                                                </MudStack>
                                            </MudCardContent>
                                        </MudCard>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudPaper>

                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </MudItem>
    }
    else
    {
        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <MudSkeleton/>
                <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Height="100px"/>
                <MudSkeleton/>
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <MudSkeleton/>
                <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Height="300px"/>
                <MudSkeleton/>
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12">
            <MudPaper Class="pa-4 mt-4">
                <MudSkeleton/>
                <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Height="300px"/>
                <MudSkeleton/>
            </MudPaper>
        </MudItem>
    }

    <MudItem xs="12" Class="d-flex align-center justify-center">
        <MudStack Row="true" Spacing="4">
            <MudButton Variant="Variant.Filled" Disabled="@renderNotComplete" Color="Color.Info" Class="d-flex" ButtonType="ButtonType.Button" OnClick="OnCalculate">计算
            </MudButton>
            <MudButton Variant="Variant.Filled" Disabled="@renderNotComplete" Color="Color.Default" Class="d-flex" ButtonType="ButtonType.Button" OnClick="ShowTips">帮助说明
            </MudButton>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private readonly DialogParameters<TipsDialog> _tipsDialogParameters = new();
    private readonly DialogOptions _tipsDialogOptions = new();
    private readonly DialogParameters<OccupationFormulaDialog> _sfDialogParameter = new();
    private readonly DialogOptions _sfDialogOptions = new();

    private OccupationConfig _currentConfig;
    private OccupationGoods[] GoodsArray;
    private OccupationFormulas[] FormulasArray;
    private ObservableCollection<OccupationFormulas> _observableFormulas { get; set; }
    private bool firstLoad = true;
    private OccupationPageModel _occupationPageModel;
    private ObservableCollection<OccupationFormulas> FavoriteFormulas { get; set; }
    private Dictionary<string, OccupationGoods> GoodDic { get; set; }
    private string Keyword { get; set; }
    private bool renderNotComplete { get; set; }
    private bool _denseMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        renderNotComplete = true;
        _denseMode = LocalStorage.GetItem<bool>(ConstText.DenseModeName);
        await InitParameters();
        await base.OnInitializedAsync();
        LocalStorage.SetItemAsString(ConstText.LastVisitName, "sf");
    }

    private async Task OnClickFavorite(OccupationFormulas formulas, bool needTips = false)
    {
        if (needTips)
        {
            bool? result = await Dialog.ShowMessageBox(
                "操作确认",
                $"是否取消{formulas.GoodsName}的收藏？",
                yesText: "是", cancelText: "再想想");
            if (result != true)
            {
                return;
            }
        }

        formulas.Favorite = !formulas.Favorite;
        if (formulas.Favorite)
        {
            FavoriteFormulas.Add(formulas);
        }
        else
        {
            FavoriteFormulas.Remove(formulas);
        }

        SaveInfo();
        Snackbar.Add($"已{(formulas.Favorite ? "添加" : "取消")}收藏:{formulas.GoodsName}", Severity.Success);
    }

    private async Task<bool> LoadData()
    {
        try
        {
            _occupationPageModel = LocalStorage.GetItem<OccupationPageModel>(nameof(_occupationPageModel)) ?? new();
        }
        catch (Exception e)
        {
            Console.WriteLine("身份收益计算器缓存加载异常" + e);
            _occupationPageModel = new OccupationPageModel();
        }

        var result = await ConfigHelper.GetConfigJson(Client, "sf", LocalStorage);
        if (result.Item1 == ConstText.NotExistText)
        {
            Snackbar.Add(result.Item1, Severity.Error);
        }
        else
        {
            try
            {
                _currentConfig = JsonSerializer.Deserialize<OccupationConfig>(result.Item1);
                if (result.Item2)
                {
                    Snackbar.Add("配置数据更新，已加载完成", Severity.Success);
                }

                renderNotComplete = false;
            }
            catch (Exception e)
            {
                Console.WriteLine(e);
                Snackbar.Add("解析配置时出现异常，请检查网络");
            }
        }

        return result.Item2;
    }

    private async Task InitParameters()
    {
        bool haveUpdate = await LoadData();
        _tipsDialogParameters.Add(nameof(TipsDialog.ContentText), new MarkupString(_currentConfig.HelperText));
        _tipsDialogOptions.CloseButton = true;
        _sfDialogOptions.MaxWidth = MaxWidth.Medium;
        FavoriteFormulas = new ObservableCollection<OccupationFormulas>();
        if (_currentConfig == null)
        {
            Snackbar.Add(ConstText.ConfigNotFoundText, Severity.Error);
            return;
        }

        if (haveUpdate)
        {
            var oldGoodsPriceDic = _occupationPageModel.GoodsArray?.ToDictionary(s => s.Code, s => s.Price);
            _occupationPageModel.GoodsArray = _currentConfig.OccupationGoodsArray;
            foreach (var goods in _occupationPageModel.GoodsArray)
            {
                if (oldGoodsPriceDic.TryGetValue(goods.Code, out int value))
                {
                    goods.Price = value;
                }
            }

            try
            {
                var oldOccDic = _occupationPageModel.FormulasArray.Where(s => s.Favorite)?.ToDictionary(s => s.ID, s => s.Favorite);
                _occupationPageModel.FormulasArray = _currentConfig.OccupationFormulaArray;
                foreach (var occ in _occupationPageModel.FormulasArray)
                {
                    occ.Value = 0;
                    if (oldOccDic.ContainsKey(occ.ID))
                    {
                        occ.Favorite = true;
                    }
                }
            }
            catch (Exception e)
            {
                Console.WriteLine(e);
                Snackbar.Add("<ul><li>由于数据结构升级</li><li>原版本的商品价格和收藏状态无法继承，非常抱歉</li></ul>", Severity.Warning);
            }

            if (_occupationPageModel.CurrentInternalVersion != -99999)
            {
                Snackbar.Add("<ul><li>已成功继承商品价格和收藏状态</li><li>身份收益需手动计算一次</li></ul>", Severity.Success);
            }

            _occupationPageModel.CurrentInternalVersion = _currentConfig.InternalVersion;
            SaveInfo();
        }

        GoodDic = _occupationPageModel.GoodsArray.ToDictionary(s => s.Code, s => s);

        foreach (var item in _occupationPageModel.FormulasArray.Where(s => s.Favorite))
        {
            FavoriteFormulas.Add(item);
        }

        _observableFormulas = new ObservableCollection<OccupationFormulas>(_occupationPageModel.FormulasArray);
    }

    private void OnCalculate()
    {
        if (!renderNotComplete)
        {
            
        }
        
        if (_occupationPageModel.GoodsArray.Any(s => s.Price < 1))
        {
            Snackbar.Add("<ul><li>有商品价格不在1~100000的范围内</li><li>请检查定价后再试</li></ul>", Severity.Warning);
            return;
        }

        var dic = _occupationPageModel.GoodsArray.ToDictionary(s => s.Code, s => s.Price);
        var results = OccupationUtility.CalculateResults(_occupationPageModel.FormulasArray, dic);
        for (var i = 0; i < results.Length; i++)
        {
            if (results[i].HasValue)
            {
                _occupationPageModel.FormulasArray[i].Value = results[i].Value;
            }
        }

        Snackbar.Add(ConstText.SuccessText, Severity.Success);

        SaveInfo();
    }

    private void SaveInfo()
    {
        LocalStorage.SetItem(nameof(_occupationPageModel), _occupationPageModel);
    }

    private void ShowTips()
    {
        Dialog.Show<TipsDialog>("帮助说明", _tipsDialogParameters, _tipsDialogOptions);
    }

    private Task WarningTips()
    {
        Snackbar.Add(ConstText.WarningText, Severity.Warning);

        return Task.CompletedTask;
    }

    private void OnRowClick(TableRowClickEventArgs<OccupationFormulas> tableRowClickEventArgs)
    {
        ShowFormula(tableRowClickEventArgs.Item);
    }

    private async Task ShowFormula(OccupationFormulas formula)
    {
        List<OccupationGoods> relatedGoods = new List<OccupationGoods>();
        foreach (string paraName in formula.FormulaParam)
        {
            if (GoodDic.TryGetValue(paraName, out var value))
            {
                relatedGoods.Add(value);
            }
        }

        _sfDialogParameter["Formulas"] = formula;
        _sfDialogParameter["GoodsArray"] = relatedGoods.ToArray();
        _sfDialogParameter["DenseMode"] = _denseMode;
        var dialog = await Dialog.ShowAsync<OccupationFormulaDialog>("", _sfDialogParameter, _sfDialogOptions);
        var result = await dialog.Result;
        StateHasChanged();
        if (!result.Canceled)
        {
            Snackbar.Add("修改已保存，请重新计算获取最新收益", Severity.Success);
        }
    }

    private void OnSearch()
    {
        if (string.IsNullOrEmpty(Keyword))
        {
            _observableFormulas = new ObservableCollection<OccupationFormulas>(_occupationPageModel.FormulasArray);
        }
        else
        {
            _observableFormulas = new ObservableCollection<OccupationFormulas>(_occupationPageModel.FormulasArray.Where(s => s.GoodsName.Contains(Keyword)));
        }

        Snackbar.Add("搜索完毕", Severity.Info);
    }

}