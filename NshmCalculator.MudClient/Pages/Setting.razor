@page "/settings"
@using System.Text
@using System.Text.Json
@using BlazorDownloadFile
@using Blazored.LocalStorage
@using NshmCalculator.MudClient.Components.Dialog
@using NshmCalculator.MudClient.Utilities
@using Color = MudBlazor.Color
@inject ISyncLocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>设置</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudSwitch T="bool" @bind-Value="@_autoRedirect" CheckedChanged="@OnRedirectCheckChanged" Color="Color.Info"
                   UnCheckedColor="Color.Dark" Label="访问首页时跳转到最近一次访问的计算器"/>
    </MudItem>
    <MudItem xs="12">
        <MudAlert Severity="Severity.Info">仅通过点击/输入链接跳转至首页时有效，在页面内部切换到首页不受该开关影响</MudAlert>
    </MudItem>
    <MudItem xs="12">
        <MudSwitch T="bool" @bind-Value="@_dense" CheckedChanged="@OnDenseCheckChanged" Color="Color.Info"
                   UnCheckedColor="Color.Dark" Label="紧凑布局"/>
    </MudItem>
    <MudItem xs="12">
        <MudAlert Severity="Severity.Info">启用此选项后，开启后将减少文本框/下拉菜单的高度，适合需要在同一屏幕中查看更多选项的情形</MudAlert>
    </MudItem>
    <MudItem xs="12">
        <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@ClearSelectedStorage">清空本地存储</MudButton>
    </MudItem>
    <MudItem xs="12">
        <MudAlert Severity="Severity.Warning">如果本地存储出现了问题，可尝试通过该按钮清空本地存储，会丢失选中的数据</MudAlert>
    </MudItem>
    <MudItem xs="3">
        <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@ExportConfig">导出配置</MudButton>
    </MudItem>
    <MudItem xs="3">
        <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@ImportConfig">导入配置</MudButton>
    </MudItem>
    <MudItem xs="3">
        <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@UploadOnlineConfig">上传配置</MudButton>
    </MudItem>
    <MudItem xs="3">
        <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@ReadOnlineConfig">同步配置</MudButton>
    </MudItem>
    <MudItem xs="12">
        <MudAlert Severity="Severity.Info">导出/导入配置：可将计算器配置导出至设备，再通过导入配置导入到其他浏览器上的计算器内；上传/同步配置：可将计算器上传到三方临时服务，并通过同步配置功能同步已上传的配置</MudAlert>
    </MudItem>
</MudGrid>

@code {
    private bool _autoRedirect = false;
    private bool _visible;
    private bool _dense;
    private readonly DialogOptions _dialogOptions = new() { DisableBackdropClick = true, FullWidth = true };
    private DialogParameters<SelectCalculatorDialog> _selectParameters { get; set; }
    private DialogParameters<ImportConfigDialog> _importParameters { get; set; }
    private DialogParameters<UploadDialog> _uploadParameters { get; set; }
    private IEnumerable<string> options { get; set; } = new HashSet<string>();
    [Inject] IBlazorDownloadFileService BlazorDownloadFileService { get; set; }

    private readonly string[] _calculatorNameArray = ["PVE计算器", "身份收益计算器", "素问治疗计算器"];

    private readonly Dictionary<string, string[]> _dic = new()
    {
        { "PVE计算器", ["config_pve", "_pvePageModel"] },
        { "身份收益计算器", ["config_sf", "_occupationPageModel"] },
        { "素问治疗计算器", ["config_syTreat", "_treatPageModel"] },
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        InitStatus();
        _selectParameters = new DialogParameters<SelectCalculatorDialog>();
        _importParameters = new DialogParameters<ImportConfigDialog>();
        _uploadParameters = new DialogParameters<UploadDialog>();
        _selectParameters.Add(nameof(SelectCalculatorDialog.NameArray), new string[] { });
        _importParameters.Add(nameof(ImportConfigDialog.OptionDic), null);
        _importParameters.Add(nameof(ImportConfigDialog.SyncMode), false);
        _uploadParameters.Add(nameof(UploadDialog.JsonText), string.Empty);
    }

    private void InitStatus()
    {
        if (LocalStorage.ContainKey(ConstText.AutoRedirectName))
        {
            _autoRedirect = LocalStorage.GetItem<bool>(ConstText.AutoRedirectName);
        }

        if (LocalStorage.ContainKey(ConstText.DenseModeName))
        {
            _dense = LocalStorage.GetItem<bool>(ConstText.DenseModeName);
        }

        SaveStatus();
    }

    private void SaveStatus()
    {
        LocalStorage.SetItem(ConstText.AutoRedirectName, _autoRedirect);
        LocalStorage.SetItem(ConstText.DenseModeName, _dense);
    }

    private void OnRedirectCheckChanged(bool status)
    {
        _autoRedirect = status;
        SaveStatus();
    }

    private void OnDenseCheckChanged(bool status)
    {
        _dense = status;
        SaveStatus();
    }

    private async Task ClearSelectedStorage()
    {
        _selectParameters[nameof(SelectCalculatorDialog.NameArray)] = _dic.Keys.ToArray();
        _selectParameters[nameof(SelectCalculatorDialog.OptionDescribeText)] = "请选择需要清除本地存储的计算器";
        _selectParameters[nameof(SelectCalculatorDialog.WarningText)] = "选择删除后将丢失对应的本地存储数据，请慎重选择";

        var selectOptions = await GetOptions();

        foreach (string option in selectOptions)
        {
            if (_dic.TryGetValue(option, out string[] value))
            {
                foreach (string code in value)
                {
                    LocalStorage.RemoveItem(code);
                }
            }
        }

        if (selectOptions.Length > 0)
        {
            Snackbar.Add($"已成功清空{selectOptions.Length}个计算器的本地缓存", Severity.Success);
        }
    }

    /// <summary>
    /// 在设置好参数后调用此方法获取选择的选项
    /// </summary>
    /// <returns></returns>
    private async Task<string[]> GetOptions()
    {
        var dialog = await DialogService.ShowAsync<SelectCalculatorDialog>("", _selectParameters, _dialogOptions);
        using var task = dialog.Result;
        var result = await task;
        if (!result.Canceled)
        {
            if (result.Data is string[] options)
            {
                return options;
            }
        }

        return [];
    }

    private void ExportConfig()
    {
        string fullText = SerializeConfig();
        Snackbar.Add("开始导出配置文件", Severity.Success);
        BlazorDownloadFileService.DownloadFileFromText($"导出配置_{DateTime.Now:yyyyMMddHHmmss}.txt", fullText, Encoding.UTF8, "text/plain");
    }

    /// <summary>
    /// 序列化配置Json
    /// </summary>
    /// <returns></returns>
    private string SerializeConfig()
    {
        Dictionary<string, string> downloadDic = new Dictionary<string, string>();
        foreach ((string? _, string[]? value) in _dic)
        {
            if (LocalStorage.ContainKey(value.Last()))
            {
                downloadDic.Add(value.Last(), LocalStorage.GetItemAsString(value.Last()));
            }
        }

        return JsonSerializer.Serialize(downloadDic);
    }

    private void ImportConfig()
    {
        _importParameters[nameof(ImportConfigDialog.OptionDic)] = _dic.ToDictionary(s => s.Value.Last(), y => y.Key);
        _importParameters[nameof(ImportConfigDialog.SyncMode)] = false;
        DialogService.Show<ImportConfigDialog>("", _importParameters, _dialogOptions);
    }

    private void ReadOnlineConfig()
    {
        _importParameters[nameof(ImportConfigDialog.OptionDic)] = _dic.ToDictionary(s => s.Value.Last(), y => y.Key);
        _importParameters[nameof(ImportConfigDialog.SyncMode)] = true;
        DialogService.Show<ImportConfigDialog>("", _importParameters, _dialogOptions);
    }

    private void UploadOnlineConfig()
    {
        _uploadParameters[nameof(UploadDialog.JsonText)] = SerializeConfig();
        DialogService.Show<UploadDialog>("", _uploadParameters, _dialogOptions);
    }

}
