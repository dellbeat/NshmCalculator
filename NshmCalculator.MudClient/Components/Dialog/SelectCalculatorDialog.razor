@using Color = MudBlazor.Color

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            清除存储确认
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning">选择删除后将丢失对应的本地存储数据，请慎重选择</MudAlert>
        <MudSelect T="string" Label="请选择需要清除本地存储的计算器" MultiSelection="true" @bind-SelectedValues="options">
            @foreach (var state in NameArray)
            {
                <MudSelectItem T="string" Value="@state">@state</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="Cancel" Class="px-10">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="Submit" Disabled="@(!options.Any())" Class="px-10">确定</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] private MudDialogInstance MudDialog { get; set; }

    [Parameter] public string[] NameArray { set; get; }
    
    private IEnumerable<string> options { get; set; } = new HashSet<string>() { };
    
    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();
}