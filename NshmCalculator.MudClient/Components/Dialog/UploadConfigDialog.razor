@using System.Text.Json
@using Blazored.LocalStorage
@using Tewr.Blazor.FileReader
@using Color = MudBlazor.Color
@inject IFileReaderService fileReaderService
@inject ISyncLocalStorageService LocalStorage
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            导入配置
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <div class="droptarget">
                    <input type="file"
                           class="clickable"
                           @ref=dropTargetInput
                           @onchange="OnInputChange"
                           @ondragenter=OnIpDragEnter
                           @ondragleave=OnIpDragLeave
                           webkitdirectory="@useWebkit" accept=".txt"/>
                    将文件拖入至此或点击浏览

                    @foreach (var fileInfo in IpFileList.Select(x => x.FileInfo))
                    {
                        <br/>
                        if (useWebkit)
                        {
                            @fileInfo.NonStandardProperties["webkitRelativePath"]
                        }
                        else
                        {
                            @fileInfo.Name
                        }
                    }
                </div>
                <MudItem xs="12">
                    <MudButton Color="Color.Info" OnClick="ReadClick">加载文件</MudButton>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="string" Label="请选择需要导入的计算器" MultiSelection="true" @bind-SelectedValues="options"
                               Disabled="@(availableList.Count == 0)">
                        @foreach (var state in availableList)
                        {
                            <MudSelectItem T="string" Value="@state">@state</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="Cancel" Class="px-10">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="Submit" Class="px-10">确认导入</MudButton>
    </DialogActions>
</MudDialog>

<MudGrid>

</MudGrid>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; }

    /// <summary>
    /// 以代号-对应计算器名称的形式传入
    /// </summary>
    [Parameter]
    public Dictionary<string, string> OptionDic { get; set; }

    bool useWebkit = false;
    ElementReference dropTargetInput;
    IFileReaderRef ipReference;
    List<string> _ipdropClasses = [dropTargetClass];
    const string dropTargetDragClass = "droptarget-drag";
    const string dropTargetClass = "droptarget";
    List<FileWithStream> IpFileList { get; } = new();
    bool visible { get; set; } = false;
    Dictionary<string, string> availableDic { get; set; } = new();
    List<string> availableList { get; set; } = new();
    private IEnumerable<string> options { get; set; } = new HashSet<string>() { };

    private class FileWithStream
    {
        public IFileInfo FileInfo { get; set; }
        public AsyncDisposableStream Stream { get; set; }
    }


    protected override async Task OnAfterRenderAsync(bool isFirstRender)
    {
        if (isFirstRender)
        {
            ipReference = fileReaderService.CreateReference(dropTargetInput);
        }
    }

    private async Task ClearAsync()
    {
        foreach (var disposable in IpFileList.Select(x => x.Stream))
        {
            await disposable.DisposeAsync();
        }

        IpFileList.Clear();
    }

    private void OnIpDragEnter(EventArgs e) => _ipdropClasses.Add(dropTargetDragClass);

    private void OnIpDragLeave(EventArgs e) => _ipdropClasses.Remove(dropTargetDragClass);

    private async Task OnInputChange(EventArgs e)
    {
        _ipdropClasses.Remove(dropTargetDragClass);
        StateHasChanged();
        await RefreshFileList();
    }

    private async Task RefreshFileList()
    {
        await ClearAsync();

        foreach (var file in await ipReference.EnumerateFilesAsync())
        {
            var fileInfo = await file.ReadFileInfoAsync();
            IpFileList.Add(new FileWithStream { FileInfo = fileInfo, Stream = await file.OpenReadAsync() });
        }

        StateHasChanged();
    }

    private async Task ReadClick() => await ReadFile(ipReference);

    private async Task ReadFile(IFileReaderRef list)
    {
        _ = InvokeAsync(StateHasChanged);

        foreach (var pair in IpFileList.ToList())
        {
            var fileInfo = pair.FileInfo;
            _ = InvokeAsync(StateHasChanged);
            fileInfo.PositionInfo.PositionChanged += (s, e) => { _ = InvokeAsync(StateHasChanged); };

            var bufferSize = 20480;
            string output = string.Empty;
            await using (var fs = pair.Stream)
            using (StreamReader sr = new StreamReader(fs))
            {
                output = await sr.ReadToEndAsync();

                availableDic.Clear();
                availableList.Clear();
                foreach ((string? key, string? value) in JsonSerializer.Deserialize<Dictionary<string, string>>(output))
                {
                    if (OptionDic.TryGetValue(key, out string? name))
                    {
                        availableList.Add(name);
                        availableDic.Add(key, value);
                    }
                }

                Snackbar.Add($"读取到{availableList.Count}个可用配置，可在下方选择", Severity.Info);
            }

            _ = InvokeAsync(StateHasChanged);
        }

        await ClearAsync();
        await RefreshFileList();
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (options == null || !options.Any())
        {
            return;
        }

        foreach (string option in options)
        {
            if (OptionDic.First(s => s.Value == option) is KeyValuePair<string, string> keyValuePair)
            {
                LocalStorage.SetItemAsString(keyValuePair.Key, availableDic[keyValuePair.Key]);
            }
        }

        Snackbar.Add($"已成功导入选中的{options.Count()}个配置", Severity.Success);

        MudDialog.Close(DialogResult.Ok(true));
    }

}