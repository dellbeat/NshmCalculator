<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0"/>
        <PackageReference Include="NUnit" Version="3.13.3"/>
        <PackageReference Include="NUnit3TestAdapter" Version="4.2.1"/>
        <PackageReference Include="NUnit.Analyzers" Version="3.6.1"/>
        <PackageReference Include="coverlet.collector" Version="6.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 无头浏览器 E2E 测试：验证设置页「清空本地存储」在真实浏览器 localStorage 下的端到端行为。
             ISyncLocalStorageService 依赖 JS 互操作，bUnit 无法覆盖，故用 Playwright.NET（与现有 NUnit/net8.0 一致）。
             首次需执行：pwsh bin/Debug/net8.0/playwright.ps1 install chromium -->
        <PackageReference Include="Microsoft.Playwright" Version="1.44.0"/>
        <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.44.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NshmCalcuator\Shared\NshmCalcuator.Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 回归测试数据：由 tools/syTreat_case_gen.py 用 Excel COM 真实重算生成，
             供 TreatUtilityTest 做 C# 公式翻译的数值回归校验。
             复制到输出目录的 testdata\，测试用相对路径 testdata/xxx.json 读取。 -->
        <Content Include="TestData\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>testdata\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Content>
        <!-- 运行时配置(wwwroot/data + index.html)：测试通过相对路径 data/xxx.json 读取
             (GlobalConfigTest / TreatUtilityTest / IndexTest 等)。原 PreBuild 自定义 Target 在
             SDK 样式工程下不保证触发，改用标准 Content 项保证每次构建都同步最新配置。 -->
        <Content Include="$(SolutionDir)NshmCalculator.MudClient\wwwroot\data\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>data\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Content>
        <Content Include="$(SolutionDir)NshmCalculator.MudClient\wwwroot\index.html">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>data\index.html</Link>
        </Content>
    </ItemGroup>

</Project>
